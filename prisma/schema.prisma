generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum role {
  user 
  moderator 
  admin
}

enum accident_severity {
  low
  medium
  high
  critical
}
enum accident_classificacao {
  com_vitima
  sem_vitima
}

enum accident_condicao_meteorologica {
  ceu_claro
  chuva
  nublado
  garoa
}

enum accident_source {
  APP
  PRF
}

enum accident_moderation_status {
  PENDING
  APPROVED
  REJECTED
}

enum push_platform {
  android
  ios
}

model User {
  id  String @id @default(uuid())
  name String
  email String @unique
  password_hash String?
  google_id String? 
  is_email_verified Boolean @default(false)
  role role @default(user)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accidents Accident[]
  moderated_accidents Accident[] @relation("AccidentModerator")
  accident_comments AccidentComment[]
  accident_trust_votes AccidentTrustVote[]
  accident_images AccidentImage[]
  moderation_decisions AccidentModerationHistory[]
  push_tokens PushToken[]
  refresh_tokens RefreshToken[]
  verification_tokens VerificationToken[]
}

model PushToken {
  id         String        @id @default(uuid())
  user_id    String
  token      String        @unique
  platform   push_platform
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model VerificationToken {
  id String @id @default(uuid())
  token String @unique
  user_id String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model Accident {
  id String @id @default(uuid())
   tipo_acidente   String @map("title")
  classificacao_acidente accident_classificacao @default(sem_vitima)
  condicao_meteorologica accident_condicao_meteorologica @default(ceu_claro)

  description String?
  latitude Float
  longitude Float
  occurred_at DateTime
  severity accident_severity
  created_by_id String?
  source accident_source @default(APP)
  source_record_id String?
  source_year Int?
  source_record_key String? @unique
  moderation_status accident_moderation_status @default(PENDING)
  moderation_message String?
  moderation_internal_note String?
  moderated_at DateTime?
  moderated_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by User? @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  moderated_by User? @relation("AccidentModerator", fields: [moderated_by_id], references: [id], onDelete: SetNull)
  comments AccidentComment[]
  trust_votes AccidentTrustVote[]
  images AccidentImage[]
  moderation_history AccidentModerationHistory[]

  @@index([created_by_id])
  @@index([occurred_at])
  @@index([severity])
  @@index([moderation_status, created_at])
}

model AccidentModerationHistory {
  id String @id @default(uuid())
  accident_id String
  moderated_by_id String
  previous_status accident_moderation_status
  new_status accident_moderation_status
  public_message String?
  internal_note String?
  created_at DateTime @default(now())

  accident Accident @relation(fields: [accident_id], references: [id], onDelete: Restrict)
  moderated_by User @relation(fields: [moderated_by_id], references: [id], onDelete: Restrict)

  @@index([accident_id, created_at])
  @@index([moderated_by_id])
}

model AccidentComment {
  id String @id @default(uuid())
  accident_id String
  created_by_id String
  body String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accident Accident @relation(fields: [accident_id], references: [id], onDelete: Cascade)
  created_by User @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  @@index([accident_id])
  @@index([created_by_id])
  @@index([created_at])
}

model AccidentTrustVote {
  id            String   @id @default(uuid())
  accident_id   String
  created_by_id String
  created_at    DateTime @default(now())

  accident   Accident @relation(fields: [accident_id], references: [id], onDelete: Cascade)
  created_by User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  @@unique([accident_id, created_by_id])
  @@index([created_by_id])
}

model AccidentImage {
  id String @id @default(uuid())
  accident_id String
  created_by_id String
  image_url String
  caption String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accident Accident @relation(fields: [accident_id], references: [id], onDelete: Cascade)
  created_by User @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  @@index([accident_id])
  @@index([created_by_id])
  @@index([created_at])
}

model RefreshToken {
  id String @id @default(uuid())
  user_id String
  token_hash String @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}