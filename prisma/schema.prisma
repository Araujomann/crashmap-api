generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum role {
  user 
  moderator 
  admin
}

enum accident_severity {
  low
  medium
  high
  critical
}

model User {
  id  String @id @default(uuid())
  name String
  email String @unique
  password_hash String?
  google_id String? 
  role role @default(user)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accidents Accident[]
  refresh_tokens RefreshToken[]
}

model Accident {
  id String @id @default(uuid())
  title String
  description String?
  latitude Float
  longitude Float
  occurred_at DateTime
  severity accident_severity
  created_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by User? @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([created_by_id])
  @@index([occurred_at])
  @@index([severity])
}

model RefreshToken {
  id String @id @default(uuid())
  user_id String
  token_hash String @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}