NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crashmap?schema=public"
ACCESS_TOKEN_SECRET="change-me-access-token-secret"
REFRESH_TOKEN_SECRET="change-me-refresh-token-secret"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:19006
ADMIN_PANEL_URL=http://localhost:3000
# Origens de navegador aceitas pela API (separadas por vírgula). O painel usa o
# servidor (BFF) e não precisa estar aqui. Vazio: FRONTEND_URL em dev; nenhuma em produção.
CORS_ORIGINS=
# De quem aceitar X-Forwarded-For (IP real do cliente na auditoria e nos limites).
# Vazio: loopback em dev (painel local); ninguém em produção.
# Produção: o IP do painel/proxy, uma lista separada por vírgula, ou o número de proxies à frente.
TRUST_PROXY=
# Limite de tentativas em login, cadastro, senha esquecida e aceite de convite.
# Só desligue ("false") para depurar localmente.
RATE_LIMIT_ENABLED=true
SMTP_USER=seu-endereco@gmail.com
SMTP_PASS=sua-senha-de-aplicativo-do-google
SMTP_FROM=seu-endereco@gmail.com
PRF_SOURCE_URL="https://drive.google.com/file/d/1A3IirNm0AzRaSosA1IS94DOVmvKsn0Ol/view?usp=sharing/download"
PRF_SOURCE_YEAR=2026